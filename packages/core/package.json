{
  "name": "@revertwtf/core",
  "version": "0.1.2",
  "description": "Shared types and helpers for revert.wtf",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "evm",
    "ethereum",
    "typescript",
    "errors"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrtdlgc/revertwtf.git",
    "directory": "packages/core"
  },
  "homepage": "https://revert.wtf",
  "bugs": {
    "url": "https://github.com/mrtdlgc/revertwtf/issues"
  },
  "sideEffects": false
}
