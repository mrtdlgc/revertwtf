{
  "name": "@revertwtf/search",
  "version": "0.1.2",
  "description": "SQLite-backed catalog lookup and FTS search for revert.wtf",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-catalog-sqlite.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@revertwtf/catalog": "workspace:*",
    "@revertwtf/core": "workspace:*",
    "better-sqlite3": "^11.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "evm",
    "ethereum",
    "sqlite",
    "fts",
    "catalog",
    "errors"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrtdlgc/revertwtf.git",
    "directory": "packages/search"
  },
  "homepage": "https://revert.wtf",
  "bugs": {
    "url": "https://github.com/mrtdlgc/revertwtf/issues"
  }
}
